{
  "name": "forge-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "simulate": "playwright test --config=e2e/simulation/playwright.simulation.config.ts",
    "simulate:headed": "playwright test --config=e2e/simulation/playwright.simulation.config.ts --headed",
    "e2e:gen-docs": "playwright test --config=e2e/playwright.config.ts --grep generate-ui-docs --timeout 300000",
    "e2e:gen-docs:headed": "playwright test --config=e2e/playwright.config.ts --grep generate-ui-docs --timeout 300000 --headed",
    "e2e:gen-landmarks": "playwright test --config=e2e/playwright.config.ts --grep generate-ui-landmarks --timeout 300000",
    "e2e:gen-all": "npm run e2e:gen-docs && npm run e2e:gen-landmarks",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "audit:tours": "npx tsx scripts/audit-tours.ts",
    "audit:screenshots": "npx tsx e2e/stress/audit-screenshots.ts",
    "audit:review": "npx tsx e2e/stress/review-screenshots.ts",
    "training:verify": "npx tsx e2e/training-verification/verify-training.ts",
    "training:verify:fix": "npx tsx e2e/training-verification/verify-training.ts --fix",
    "lint": "ng lint --max-warnings=77",
    "lint:a11y": "npx eslint \"src/**/*.html\" --no-error-on-unmatched-pattern",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "lint:standards": "node scripts/lint-standards.mjs",
    "test:a11y": "npx cypress run --spec cypress/e2e/accessibility/a11y.cy.ts",
    "test:api-smoke": "playwright test --config=e2e/playwright.config.ts --grep api-smoke --timeout 120000",
    "test:contract-drift": "playwright test --config=e2e/playwright.config.ts --grep contract-drift --timeout 60000",
    "test:critical-flows": "playwright test --config=e2e/playwright.config.ts --grep Critical --timeout 120000",
    "test:smoke": "npm run test:api-smoke && npm run test:contract-drift && npm run test:critical-flows",
    "scenario": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts",
    "scenario:headed": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed",
    "scenario:onboarding": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"01|02a|03a\"",
    "scenario:orders": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"01|02b|03b\"",
    "scenario:production": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"01|02c|03c\"",
    "scenario:expenses": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"01|02c|03d\"",
    "scenario:populate": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --grep \"01|02d\"",
    "scenario:qb-sandbox": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"01|02e\"",
    "scenario:qb-clean": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"00\"",
    "scenario:qb-fresh": "playwright test --config=e2e/scenarios/playwright.scenarios.config.ts --headed --grep \"00|01|02e\"",
    "screenshots": "playwright test --config=e2e/screenshots/playwright.screenshots.config.ts",
    "screenshots:headed": "playwright test --config=e2e/screenshots/playwright.screenshots.config.ts --headed",
    "stress": "npx tsx e2e/stress/run.ts",
    "stress:quick": "cross-env E2E_STRESS_DURATION=600000 npx tsx e2e/stress/run.ts",
    "build:mobile": "ng build --configuration=mobile",
    "cap:sync": "npm run build:mobile && npx cap sync"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/material-date-fns-adapter": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@angular/service-worker": "^22.1.4",
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.8",
    "@capacitor/device": "^7.0.5",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/network": "^7.0.4",
    "@danielhokanson/ng-dynamic-forms-core": "^22.0.0",
    "@danielhokanson/ng-dynamic-forms-ui-material": "^22.0.0",
    "@fontsource-variable/alumni-sans-sc": "^5.2.3",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/material-icons-outlined": "^5.3.0",
    "@fontsource/raleway": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@microsoft/signalr": "^10.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.183.1",
    "angularx-qrcode": "^22.0.1",
    "bwip-js": "^4.8.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-sankey": "^0.14.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "gridstack": "^12.4.2",
    "html5-qrcode": "^2.3.8",
    "marked": "^18.0.11",
    "ng2-charts": "^10.0.0",
    "ngx-extended-pdf-viewer": "^29.0.1",
    "ngx-markdown": "^22.0.0",
    "ngx-mask": "^22.1.0",
    "ngx-quill": "^31.0.1",
    "papaparse": "^5.5.3",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "three": "^0.183.2",
    "tslib": "^2.3.0",
    "write-excel-file": "^4.0.6"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "angular-eslint": "^22.1.0",
    "ansi-escapes": "^7.3.0",
    "axe-core": "^4.11.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "cypress": "^15.11.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.8"
  }
}
