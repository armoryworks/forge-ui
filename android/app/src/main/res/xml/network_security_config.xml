<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only, system trust store only. The app additionally pins the
     instance's certificate on first use (TlsPinPlugin). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
